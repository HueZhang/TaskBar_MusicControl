<UserControl x:Class="TaskbarWidget.Views.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TaskbarWidget.Converters">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="ArtworkVisible" />
    </UserControl.Resources>

    <!-- Media page: display-only. Clicking opens the floating control flyout. -->
    <Button Background="Transparent" BorderThickness="0" Padding="0"
            Focusable="False" Cursor="Hand"
            Command="{Binding OpenMediaFlyoutCommand}"
            ToolTip="点击打开媒体控制">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </ControlTemplate>
        </Button.Template>

        <Grid Margin="5,3,5,2" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Album art with a default fallback icon. -->
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#33FFFFFF" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons" FontSize="18"
                               Foreground="#AAFFFFFF" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding Artwork, Mode=OneWay}" Stretch="UniformToFill"
                           Visibility="{Binding Artwork, Converter={StaticResource ArtworkVisible}, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Title and artist -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title, Mode=OneWay}" />
                <TextBlock Text="{Binding Artist, Mode=OneWay}" FontSize="11" Margin="0,2,0,0"
                           Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Artist, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
