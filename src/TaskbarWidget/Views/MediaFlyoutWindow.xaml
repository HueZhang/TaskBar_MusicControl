<Window x:Class="TaskbarWidget.Views.MediaFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TaskbarWidget.Converters"
        Title="MediaControls"
        Width="164" Height="54"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        ShowActivated="False">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVisibility" />
        <Style x:Key="FlyoutButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Fully rounded translucent surface. No window-level blur is used: the
      composition API paints a square blurred rectangle behind the window,
      which shows square corners outside this rounded border. A translucent
      rounded border gives the Fluent glass look without those corners.
    -->
    <Border CornerRadius="27" Background="#CC2B2B2B"
            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Content="&#xE892;" FontSize="17" Width="38" Height="34"
                    Style="{StaticResource FlyoutButton}"
                    Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"
                    ToolTip="上一曲" />
            <Grid Width="46" Height="34" Margin="4,0">
                <Button Content="&#xE768;" FontSize="21" Width="46" Height="34"
                        Style="{StaticResource FlyoutButton}"
                        Command="{Binding TogglePlayPauseCommand}" IsEnabled="{Binding CanPlayPause}"
                        ToolTip="播放">
                    <Button.Visibility>
                        <Binding Path="IsPlaying" Converter="{StaticResource InvBoolVisibility}" />
                    </Button.Visibility>
                </Button>
                <Button Content="&#xE769;" FontSize="21" Width="46" Height="34"
                        Style="{StaticResource FlyoutButton}"
                        Command="{Binding TogglePlayPauseCommand}" IsEnabled="{Binding CanPlayPause}"
                        ToolTip="暂停">
                    <Button.Visibility>
                        <Binding Path="IsPlaying" Converter="{StaticResource BoolVisibility}" />
                    </Button.Visibility>
                </Button>
            </Grid>
            <Button Content="&#xE893;" FontSize="17" Width="38" Height="34"
                    Style="{StaticResource FlyoutButton}"
                    Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
                    ToolTip="下一曲" />
        </StackPanel>
    </Border>
</Window>
