<Window x:Class="TaskbarWidget.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TaskbarWidget.Views"
        xmlns:converters="clr-namespace:TaskbarWidget.Converters"
        Title="TaskbarWidget"
        Width="220" Height="44"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#01FFFFFF"
        Foreground="White"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <converters:DotOpacityConverter x:Key="DotOpacity" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border CornerRadius="6" Padding="0,2,0,0">
        <Grid>
            <!-- Two equal-size pages stacked; only the active one is visible/hit-testable. -->
            <views:MonitorPage DataContext="{Binding}"
                               Visibility="{Binding MonitorActive, Converter={StaticResource BoolToVisibility}}" />
            <views:MediaPage DataContext="{Binding}"
                             Visibility="{Binding MediaActive, Converter={StaticResource BoolToVisibility}}" />

            <!-- Page dots: two dots, solid = active page, clickable. Stacked vertically on the right. -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,2,0" SnapsToDevicePixels="True">
                <Button Width="10" Height="9" Padding="0" BorderThickness="0" Background="Transparent"
                        Command="{Binding SwitchToMonitorCommand}" ToolTip="监控页">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                             Opacity="{Binding MonitorActive, Converter={StaticResource DotOpacity}}" />
                </Button>
                <Button Width="10" Height="9" Padding="0" BorderThickness="0" Background="Transparent"
                        Command="{Binding SwitchToMediaCommand}" ToolTip="媒体页"
                        IsEnabled="{Binding MediaDotEnabled}">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                             Opacity="{Binding MediaActive, Converter={StaticResource DotOpacity}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
