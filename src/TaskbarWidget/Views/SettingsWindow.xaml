<ui:FluentWindow x:Class="TaskbarWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置 - TaskbarWidget" Height="380" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Acrylic">
    <Grid>
        <ui:TitleBar Title="设置" Grid.Row="0" />
        <ScrollViewer Grid.Row="0" Margin="0,44,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,12,20,20">

                <TextBlock Text="常规" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Card Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <ui:ToggleSwitch Content="开机自启" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10" />
                        <Grid>
                            <TextBlock Text="任务栏位置" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox HorizontalAlignment="Right" Width="200" SelectedIndex="{Binding PositionIndex}"
                                      ItemsSource="{Binding PositionOptions}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="监控" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Card Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="刷新频率" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox HorizontalAlignment="Right" Width="140" SelectedIndex="{Binding RefreshIndex}">
                                <ComboBoxItem Content="1 秒" />
                                <ComboBoxItem Content="2 秒" />
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <TextBlock Text="网卡" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox HorizontalAlignment="Right" Width="200" SelectedIndex="{Binding NicModeIndex}"
                                      ItemsSource="{Binding NicModeOptions}" />
                        </Grid>
                        <Grid Margin="0,10,0,0" IsEnabled="{Binding IsSpecificNic}">
                            <TextBlock Text="指定网卡" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox HorizontalAlignment="Right" Width="200"
                                      ItemsSource="{Binding NicAliases}"
                                      SelectedItem="{Binding SelectedNicAlias}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="交互" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Card Margin="0,0,0,16" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="滚轮切换" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox HorizontalAlignment="Right" Width="180" SelectedIndex="{Binding WheelModeIndex}">
                                <ComboBoxItem Content="任意方向切换" />
                                <ComboBoxItem Content="上=监控 / 下=媒体" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Button Content="保存" Appearance="Primary" HorizontalAlignment="Right" Width="100"
                           Command="{Binding SaveCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
